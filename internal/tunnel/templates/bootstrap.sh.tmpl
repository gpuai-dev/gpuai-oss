#!/bin/bash
# GPU.ai Instance Bootstrap Script (FRP Tunneling)
# Generated by gpuctl provisioning engine -- do not edit manually
# Compatible with both full VMs and Docker containers
set -uo pipefail

echo "[GPU.ai] Bootstrap starting..."

# ============================================================
# Detect environment: VM or container
# ============================================================
IS_CONTAINER=false
if [ -f /.dockerenv ] || grep -q 'docker\|containerd' /proc/1/cgroup 2>/dev/null; then
    IS_CONTAINER=true
    echo "[GPU.ai] Detected container environment"
else
    echo "[GPU.ai] Detected VM environment"
fi

# ============================================================
# 0a. Wait for clock sync (TLS gate)
# ============================================================
# Baremetal nodes boot with the clock at epoch (1970) until NTP corrects it a
# minute or more into boot. Every HTTPS call below -- the frpc download from
# github.com, the ready callback -- fails TLS ("certificate is not yet valid")
# while the clock is in the past, and cloud-init runs this script ONCE, so a
# premature failure is permanent. Block until the year looks sane (or a 300s
# deadline) before any TLS. Containers and VMs that boot with a good clock pass
# the first check instantly, so this is a no-op there.
CLOCK_DEADLINE=$(( $(date +%s) + 300 ))
while [ "$(date +%Y)" -lt 2021 ] && [ "$(date +%s)" -lt "$CLOCK_DEADLINE" ]; do
    echo "[GPU.ai] Waiting for clock sync (currently $(date -u))..."
    sleep 5
done
if [ "$(date +%Y)" -lt 2021 ]; then
    echo "[GPU.ai] WARNING: clock still at $(date -u) after 300s -- continuing, TLS may fail"
else
    echo "[GPU.ai] Clock is sane: $(date -u)"
fi

# ============================================================
# 0. Wait for outbound network (egress gate)
# ============================================================
# On some VM providers the public IP / SNAT is attached a minute or more
# AFTER the guest boots, so cloud-init runs this script before any outbound
# connectivity exists. Probe the tunnel server endpoint until it is reachable
# (it is the hard dependency for everything below) instead of failing fast
# and permanently. Containers start with networking live, so the first probe
# succeeds immediately and this gate is a no-op.
EGRESS_DEADLINE=$(( $(date +%s) + 600 ))
EGRESS_OK=false
EGRESS_ATTEMPT=0
while [ "$(date +%s)" -lt "$EGRESS_DEADLINE" ]; do
    if timeout 4 bash -c 'echo > /dev/tcp/{{.ProxyHost}}/{{.FRPServerPort}}' 2>/dev/null; then
        EGRESS_OK=true
        break
    fi
    EGRESS_ATTEMPT=$(( EGRESS_ATTEMPT + 1 ))
    if [ $(( EGRESS_ATTEMPT % 6 )) -eq 0 ]; then
        echo "[GPU.ai] Waiting for outbound network (attempt ${EGRESS_ATTEMPT})..."
    fi
    sleep 5
done
if [ "$EGRESS_OK" = true ]; then
    echo "[GPU.ai] Outbound network is up"
else
    echo "[GPU.ai] WARNING: no outbound network after 600s -- continuing anyway"
fi

# ============================================================
# 0b. Network hardening: bounded apt + retrying callbacks
# ============================================================
# Some provider VM egress flaps PER DESTINATION on a minutes scale: one
# host times out while others answer, then recovers -- and cloud-init runs
# this script ONCE. Every network step below must therefore be (a) bounded
# (an unbounded fetch against a dark host stalls the whole one-shot boot)
# and (b) retried (a failure now may succeed a minute later). apt
# transfers are bounded globally here; each curl call site carries its own
# --max-time plus either a shell retry loop or curl --retry.
mkdir -p /etc/apt/apt.conf.d 2>/dev/null || true
cat > /etc/apt/apt.conf.d/99gpuai-net-timeouts << 'APTNETEOF'
Acquire::http::Timeout "30";
Acquire::https::Timeout "30";
Acquire::Retries "3";
APTNETEOF

# ============================================================
# 0c. Ensure bootstrap dependencies (curl + sshd)
# ============================================================
# Provider-built images often bake curl and openssh-server in,
# but a vanilla Docker Hub image (pytorch/pytorch, nvidia/cuda, ...) has
# NEITHER -- and everything below depends on them: the frpc download and
# ready callback need curl, buyer SSH needs sshd. Generic-supplier
# launches run exactly such images, so install the missing pieces when a
# Debian/Ubuntu userland is present (apt transfers bounded by the
# 99gpuai-net-timeouts config above). Every branch tolerates failure --
# a non-apt image or dark mirror proceeds exactly as before this step,
# and images that already carry both tools skip it entirely.
BOOTSTRAP_DEPS_MISSING=false
command -v curl >/dev/null 2>&1 || BOOTSTRAP_DEPS_MISSING=true
[ -x /usr/sbin/sshd ] || BOOTSTRAP_DEPS_MISSING=true
if [ "$BOOTSTRAP_DEPS_MISSING" = true ] && command -v apt-get >/dev/null 2>&1; then
    echo "[GPU.ai] Installing missing bootstrap dependencies (curl / openssh-server)..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y 2>/dev/null || true
    command -v curl >/dev/null 2>&1 || \
        apt-get install -y --no-install-recommends curl ca-certificates 2>/dev/null || true
    [ -x /usr/sbin/sshd ] || \
        apt-get install -y --no-install-recommends openssh-server 2>/dev/null || true
fi
command -v curl >/dev/null 2>&1 || \
    echo "[GPU.ai] WARNING: curl unavailable -- frpc download and callbacks will fail"
[ -x /usr/sbin/sshd ] || \
    echo "[GPU.ai] WARNING: sshd unavailable -- buyer SSH will fail"

# send_callback POSTs a JSON body ($1) to the engine callback URL, retrying
# EVERY failure class -- refused, DNS, timeout, TLS, HTTP error -- because
# curl's --retry alone only covers "transient" errors and the wider
# --retry-all-errors flag is missing from older curl builds. 5 attempts,
# 15s apart, each bounded at 30s: patient enough to ride out a short
# egress blackout, bounded enough to finish inside the provisioning
# window. Callers that need more patience loop again at their own cadence.
send_callback() {
    SEND_CB_ATTEMPT=1
    while true; do
        if curl -fsS -X POST '{{.CallbackURL}}' \
            -H 'Authorization: Bearer {{.InternalToken}}' \
            -H 'Content-Type: application/json' \
            -d "$1" \
            --max-time 30; then
            return 0
        fi
        if [ "$SEND_CB_ATTEMPT" -ge 5 ]; then
            echo "[GPU.ai] callback POST failed after ${SEND_CB_ATTEMPT} attempts"
            return 1
        fi
        SEND_CB_ATTEMPT=$(( SEND_CB_ATTEMPT + 1 ))
        sleep 15
    done
}

# ============================================================
# 1. FRP Client Installation
# ============================================================
FRP_VERSION="{{.FRPVersion}}"
FRP_TARBALL="frp_${FRP_VERSION}_linux_amd64.tar.gz"

# Fast path -- image-baked frpc. Some container runtimes (live-diagnosed
# 2026-09-08) forbid making a runtime-delivered file
# executable: chmod is denied and even invoking through the dynamic loader
# (ld-linux ./frpc) returns EACCES, so a DOWNLOADED frpc can never run. The
# GPU.ai certified base image bakes frpc at /usr/local/bin/frpc as an
# image-layer executable, which DOES run there (bash/curl/python3 prove
# image-baked binaries execute). If a runnable frpc is already present, use it
# and skip the download+chmod below. On VM providers the bootstrap runs on the
# HOST (not the certified image, so no baked frpc) -- the check is a no-op and
# the download path runs unchanged.
#
# FRPC_DOWNLOADED here means "frpc is available to run", not literally that a
# download happened -- the baked path sets it true without downloading, and the
# config-write + start steps below both gate on it. The presence check trusts
# any executable at that path regardless of frp version: if FRPVersion
# (internal/tunnel/types.go) is bumped but the certified image has not yet been
# rebuilt+re-pinned, the older baked frpc is used and the newer template version
# is not downloaded. That is acceptable -- frpc's config format is stable across
# these releases and the image is rebuilt in lockstep with the pin -- but bump
# the image's FRP_VERSION alongside the const to keep them aligned.
FRPC_DOWNLOADED=false
if [ -x /usr/local/bin/frpc ]; then
    echo "[GPU.ai] frpc already installed at /usr/local/bin/frpc (image-baked); skipping download"
    FRPC_DOWNLOADED=true
fi

if [ "$FRPC_DOWNLOADED" = false ]; then
    echo "[GPU.ai] Downloading frpc v${FRP_VERSION}..."
fi

# Candidate sources in priority order: the platform mirror first (a
# short-lived presigned object URL on GPU.ai infrastructure, rendered only
# when the operator configured a bootstrap-assets bucket), then the
# upstream GitHub release. A missing frpc binary is permanent tunnel death
# (the supervisor below can restart frpc forever but cannot conjure the
# binary), so the download loops with backoff for up to 10 minutes,
# alternating sources each round -- egress to one destination being dark
# says nothing about the other.
FRPC_URLS=(
{{- if .FRPCMirrorURL}}
    '{{.FRPCMirrorURL}}'
{{- end}}
    "https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/${FRP_TARBALL}"
)

# Work under /var/tmp (rootfs), NOT /tmp: some container runtimes
# (live-diagnosed 2026-08-12) give /tmp exec-denied/perm-broken
# semantics — tar exits non-zero and the extracted frpc cannot even be
# stat'd — while the root overlay behaves normally. tar runs OUTSIDE the
# && chain with ownership/permission flags because sandboxed runtimes can
# fail chown/utime restoration (non-fatal) after extracting the payload
# fine; the frpc binary's presence is the real success signal.
GPUAI_FRP_WORK=/var/tmp/gpuai-frp
FRPC_DL_DEADLINE=$(( $(date +%s) + 600 ))
FRPC_DL_ATTEMPT=0
while [ "$FRPC_DOWNLOADED" = false ] && [ "$(date +%s)" -lt "$FRPC_DL_DEADLINE" ]; do
    for FRPC_URL in "${FRPC_URLS[@]}"; do
        rm -rf "$GPUAI_FRP_WORK" 2>/dev/null || true
        mkdir -p "$GPUAI_FRP_WORK"
        if curl -fsS -L --max-time 60 -o "$GPUAI_FRP_WORK/frp.tar.gz" "$FRPC_URL"; then
            tar xzf "$GPUAI_FRP_WORK/frp.tar.gz" -C "$GPUAI_FRP_WORK" --no-same-owner --no-same-permissions 2>/dev/null || \
                tar xzf "$GPUAI_FRP_WORK/frp.tar.gz" -C "$GPUAI_FRP_WORK" 2>/dev/null || true
            if [ -f "$GPUAI_FRP_WORK/frp_${FRP_VERSION}_linux_amd64/frpc" ] && \
               cp "$GPUAI_FRP_WORK/frp_${FRP_VERSION}_linux_amd64/frpc" /usr/local/bin/frpc && \
               chmod +x /usr/local/bin/frpc; then
                FRPC_DOWNLOADED=true
                echo "[GPU.ai] frpc ${FRP_VERSION} installed (source host: $(echo "$FRPC_URL" | cut -d/ -f3))"
                break
            fi
        fi
    done
    if [ "$FRPC_DOWNLOADED" = false ]; then
        FRPC_DL_ATTEMPT=$(( FRPC_DL_ATTEMPT + 1 ))
        FRPC_DL_SLEEP=$(( FRPC_DL_ATTEMPT * 10 ))
        [ "$FRPC_DL_SLEEP" -gt 60 ] && FRPC_DL_SLEEP=60
        echo "[GPU.ai] frpc download attempt ${FRPC_DL_ATTEMPT} failed on all sources, retrying in ${FRPC_DL_SLEEP}s..."
        sleep "$FRPC_DL_SLEEP"
    fi
done

if [ "$FRPC_DOWNLOADED" = false ]; then
    echo "[GPU.ai] WARNING: frpc download failed from all sources after retries, frpc tunnel unavailable"
fi

rm -rf "$GPUAI_FRP_WORK" 2>/dev/null || true

# ============================================================
# 2. FRP Client Configuration
# ============================================================
if [ "$FRPC_DOWNLOADED" = true ]; then
    cat > /etc/frpc.toml << 'FRPEOF'
serverAddr = "{{.ProxyHost}}"
serverPort = {{.FRPServerPort}}
auth.method = "token"
auth.token = "{{.FRPToken}}"
{{- if .FRPTransport}}
transport.protocol = "{{.FRPTransport}}"
{{- end}}

[[proxies]]
name = "{{.InstanceID}}-ssh"
type = "tcp"
localIP = "127.0.0.1"
{{- if and .CertifiedImage (eq .DeploymentType "vm")}}
# Certified VM: customer SSH terminates inside the gpuai-certified container
# (published on loopback :2222 in section 7b); host sshd keeps :22 for
# provider rescue access (GPU-57).
localPort = 2222
{{- else}}
localPort = 22
{{- end}}
remotePort = {{.RemotePort}}
{{if .AppPort}}
[[proxies]]
name = "{{.InstanceID}}-app"
type = "http"
localIP = "127.0.0.1"
localPort = {{.AppPort}}
subdomain = "{{.AppSubdomain}}"
httpUser = "{{.AppBasicAuthUser}}"
httpPassword = "{{.AppBasicAuthPass}}"
{{end}}
{{if .TerminalPort}}
[[proxies]]
name = "{{.InstanceID}}-term"
type = "http"
localIP = "127.0.0.1"
localPort = {{.TerminalPort}}
subdomain = "{{.InstanceID}}-term"
httpUser = "{{.AppBasicAuthUser}}"
httpPassword = "{{.AppBasicAuthPass}}"
{{end}}
FRPEOF

    echo "[GPU.ai] frpc config written to /etc/frpc.toml"
fi

# ============================================================
# 3. SSH Keys + Security Hardening
# ============================================================
mkdir -p /root/.ssh
cat > /root/.ssh/authorized_keys << 'SSHEOF'
{{.SSHAuthorizedKeys}}
SSHEOF
chmod 700 /root/.ssh
chmod 600 /root/.ssh/authorized_keys

# Remove any provider-injected SSH keys (backdoor prevention)
sed -i '/^#.*provider/Id' /root/.ssh/authorized_keys 2>/dev/null || true

# Disable root password authentication
if [ -f /etc/ssh/sshd_config ]; then
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
    # Restart SSH -- try systemctl first (VM), then service (container)
    systemctl restart sshd 2>/dev/null || service ssh restart 2>/dev/null || \
        /usr/sbin/sshd 2>/dev/null || true
fi

# ============================================================
# 4. Start sshd and frpc
# ============================================================
# Ensure SSH host keys exist
ssh-keygen -A 2>/dev/null || true

# Debian/Ubuntu sshd refuses to start without its privilege-separation
# directory, and a fresh openssh-server install inside a container (no
# systemd postinst) never creates it.
mkdir -p /run/sshd 2>/dev/null || true

# Start sshd if not already running
if ! pgrep -x sshd > /dev/null 2>&1; then
    /usr/sbin/sshd 2>/dev/null || true
fi

# Start frpc supervised so it survives crashes, tunnel-server restarts, and
# late networking: systemd unit on VMs, respawn loop in containers (no PID-1
# systemd there). The old single-shot nohup died permanently on any exit.
if [ "$FRPC_DOWNLOADED" = true ]; then
    echo "[GPU.ai] Starting frpc..."
    FRPC_SUPERVISED=false
    if [ "$IS_CONTAINER" = false ] && command -v systemctl > /dev/null 2>&1; then
        cat > /etc/systemd/system/gpuai-frpc.service << 'UNITEOF'
[Unit]
Description=GPU.ai tunnel client (frpc)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/frpc -c /etc/frpc.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNITEOF
        if systemctl daemon-reload 2>/dev/null && \
           systemctl enable --now gpuai-frpc 2>/dev/null; then
            FRPC_SUPERVISED=true
        fi
    fi
    if [ "$FRPC_SUPERVISED" = false ]; then
        # Container (or systemd unavailable): background respawn loop.
        nohup bash -c 'while true; do
            /usr/local/bin/frpc -c /etc/frpc.toml >> /var/log/frpc.log 2>&1
            echo "[GPU.ai] frpc exited, restarting in 5s..." >> /var/log/frpc.log
            sleep 5
        done' > /dev/null 2>&1 &
    fi
    sleep 2
    if pgrep -x frpc > /dev/null 2>&1; then
        echo "[GPU.ai] frpc is running (tunnel active)"
    else
        echo "[GPU.ai] WARNING: frpc failed to start, check /var/log/frpc.log"
    fi
fi

{{if .TerminalPort}}
# ============================================================
# 4b. Web console (ttyd browser terminal)
# ============================================================
# A browser shell served on 127.0.0.1:{{.TerminalPort}} and vhost-proxied by
# frps at <instance>-term.<apps host> behind the same basic-auth credential as
# the template app -- reachable only through the gateway (loopback bind), no
# SSH key required. NOT boot-critical: every failure path below degrades to a
# warning; the instance must come up SSH-usable even if the console doesn't.
TTYD_VERSION="{{.TtydVersion}}"
TTYD_INSTALLED=false
if [ "$(uname -m)" = "x86_64" ]; then
    TTYD_URLS=(
{{- if .TtydMirrorURL}}
        '{{.TtydMirrorURL}}'
{{- end}}
        "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64"
    )
    # 3 bounded rounds over both sources (mirror first) -- lighter than the
    # frpc loop because a missing console never blocks the boot.
    TTYD_DL_ATTEMPT=0
    while [ "$TTYD_INSTALLED" = false ] && [ "$TTYD_DL_ATTEMPT" -lt 3 ]; do
        for TTYD_URL in "${TTYD_URLS[@]}"; do
            # Download to /var/tmp, validate at a STAGING name inside
            # /usr/local/bin, and only rename over the real target on
            # success: /tmp can be exec-denied on sandboxed runtimes (the
            # same sandboxed-runtime quirk as the frpc block above), and a
            # bootstrap re-run over a persisted fs (pod restart) must never
            # clobber a previously working ttyd on a transient download
            # failure.
            if curl -fsS -L --max-time 60 -o /var/tmp/gpuai-ttyd "$TTYD_URL" && \
               mv /var/tmp/gpuai-ttyd /usr/local/bin/.gpuai-ttyd.new && \
               chmod +x /usr/local/bin/.gpuai-ttyd.new && /usr/local/bin/.gpuai-ttyd.new --version >/dev/null 2>&1; then
                mv /usr/local/bin/.gpuai-ttyd.new /usr/local/bin/ttyd
                TTYD_INSTALLED=true
                echo "[GPU.ai] ttyd ${TTYD_VERSION} installed (source host: $(echo "$TTYD_URL" | cut -d/ -f3))"
                break
            fi
            rm -f /usr/local/bin/.gpuai-ttyd.new 2>/dev/null || true
        done
        if [ "$TTYD_INSTALLED" = false ]; then
            TTYD_DL_ATTEMPT=$(( TTYD_DL_ATTEMPT + 1 ))
            sleep $(( TTYD_DL_ATTEMPT * 5 ))
        fi
    done
    rm -f /var/tmp/gpuai-ttyd 2>/dev/null || true
else
    echo "[GPU.ai] WARNING: unsupported arch $(uname -m) for web console, skipping"
fi

if [ "$TTYD_INSTALLED" = true ]; then
    # Per-connection entry point: land in the same environment SSH lands in.
    # On a certified VM the customer's SSH terminates inside the
    # gpuai-certified container, so the console execs into it when (and only
    # when) it is running -- re-checked per connection because the container
    # starts AFTER this section on first boot.
    cat > /usr/local/bin/gpuai-console.sh << 'CONSOLEEOF'
#!/bin/bash
if command -v docker >/dev/null 2>&1; then
    CID=$(docker ps -q --filter "name=^gpuai-certified$" 2>/dev/null)
    if [ -n "$CID" ]; then
        exec docker exec -it gpuai-certified /bin/bash -l
    fi
fi
exec /bin/bash -l
CONSOLEEOF
    chmod +x /usr/local/bin/gpuai-console.sh

    # Loopback bind: the ONLY route in is frpc's authenticated vhost proxy.
    TTYD_CMD="/usr/local/bin/ttyd --port {{.TerminalPort}} --interface 127.0.0.1 --writable /usr/local/bin/gpuai-console.sh"
    TTYD_SUPERVISED=false
    if [ "$IS_CONTAINER" = false ] && command -v systemctl > /dev/null 2>&1; then
        cat > /etc/systemd/system/gpuai-ttyd.service << UNITEOF
[Unit]
Description=GPU.ai web console (ttyd)
After=network-online.target

[Service]
ExecStart=${TTYD_CMD}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNITEOF
        if systemctl daemon-reload 2>/dev/null && \
           systemctl enable --now gpuai-ttyd 2>/dev/null; then
            TTYD_SUPERVISED=true
        fi
    fi
    if [ "$TTYD_SUPERVISED" = false ]; then
        # Container (or systemd unavailable): background respawn loop.
        nohup bash -c "while true; do
            ${TTYD_CMD} >> /var/log/gpuai-ttyd.log 2>&1
            echo '[GPU.ai] ttyd exited, restarting in 5s...' >> /var/log/gpuai-ttyd.log
            sleep 5
        done" > /dev/null 2>&1 &
    fi
    echo "[GPU.ai] web console started on 127.0.0.1:{{.TerminalPort}}"
else
    echo "[GPU.ai] WARNING: web console unavailable (ttyd not installed)"
fi
{{end}}

# ============================================================
# 5. Provider Scrubbing (BEFORE branding, so we start clean)
# ============================================================
# Block cloud metadata endpoint
if command -v iptables &>/dev/null; then
    iptables -A OUTPUT -d 169.254.169.254 -j DROP 2>/dev/null || true
fi

# Clean provider branding from all MOTD/login sources
rm -f /etc/update-motd.d/* 2>/dev/null || true
rm -f /etc/motd.d/* 2>/dev/null || true
rm -f /etc/legal 2>/dev/null || true

# GPU-62: neutralize the sshd PRE-AUTH banner. This is a separate channel from
# /etc/motd (which is post-login): some providers serve a welcome text via
# sshd's Banner directive, printed before the shell ever runs, so none of the
# MOTD scrubbing above touches it. It reaches the customer over the FRP tunnel
# (customer -> our frps -> frpc -> the instance's own sshd). Overwrite the
# conventional Banner target (issue.net) AND whatever file an explicit Banner
# directive points at, then set the directive to none and HUP sshd so the change
# takes effect for new connections (issue.net content is re-read per-connection;
# a directive change needs the reload). All defensive -- image layouts differ.
printf 'GPU.ai\n' > /etc/issue 2>/dev/null || true       # local console banner
printf 'GPU.ai\n' > /etc/issue.net 2>/dev/null || true   # default sshd Banner target
if [ -f /etc/ssh/sshd_config ]; then
    BANNER_FILE=$(awk 'tolower($1)=="banner" && $2!="none" {print $2; exit}' /etc/ssh/sshd_config 2>/dev/null)
    if [ -n "${BANNER_FILE:-}" ] && [ "$BANNER_FILE" != "/etc/issue.net" ] && [ -f "$BANNER_FILE" ]; then
        printf 'GPU.ai\n' > "$BANNER_FILE" 2>/dev/null || true
    fi
    if grep -qiE '^[[:space:]]*Banner[[:space:]]' /etc/ssh/sshd_config 2>/dev/null; then
        sed -i -E 's|^[[:space:]]*Banner[[:space:]].*|Banner none|I' /etc/ssh/sshd_config 2>/dev/null || true
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || \
            pkill -HUP -x sshd 2>/dev/null || true
    fi
fi

# ============================================================
# 6. Branded Hostname + MOTD (after scrubbing)
# ============================================================
# Set hostname (hostnamectl for VMs, direct write for containers)
hostnamectl set-hostname '{{.Hostname}}' 2>/dev/null || \
    echo '{{.Hostname}}' > /etc/hostname 2>/dev/null || true
echo '127.0.0.1 {{.Hostname}}' >> /etc/hosts

# Containers can't change the live kernel hostname (hostnamectl needs
# systemd, sethostname needs CAP_SYS_ADMIN), so \h in the default prompt
# leaks the provider's container id. When the hostname didn't take, pin a
# branded prompt instead.
if [ "$(hostname 2>/dev/null)" != '{{.Hostname}}' ]; then
    cat >> /root/.bashrc << 'PSEOF'
# GPU.ai prompt (container hostname is fixed by the runtime)
PS1='\u@{{.Hostname}}:\w\$ '
PSEOF
fi

cat > /etc/motd << 'MOTDEOF'

  ██████╗ ██████╗ ██╗   ██╗   █████╗ ██╗
 ██╔════╝ ██╔══██╗██║   ██║  ██╔══██╗██║
 ██║  ███╗██████╔╝██║   ██║  ███████║██║
 ██║   ██║██╔═══╝ ██║   ██║  ██╔══██║██║
 ╚██████╔╝██║     ╚██████╔╝  ██║  ██║██║
  ╚═════╝ ╚═╝      ╚═════╝   ╚═╝  ╚═╝╚═╝

 Welcome to GPU.ai
 Instance: {{.Hostname}}

MOTDEOF

# ============================================================
# 7. NVIDIA Driver Verification
# ============================================================
GPU_INFO=""
# Phase 63 env-report fields (empty-string on paths where not applicable). All
# three ready/fail callbacks below carry these so the server can record the
# actual boot environment (driver_version, cuda_version, certified image digest,
# container status).
DRIVER_VERSION=""
CUDA_VERSION=""
CERTIFIED_IMAGE_DIGEST=""
CONTAINER_ID=""
DOCKER_UP=false
if command -v nvidia-smi &>/dev/null; then
    GPU_INFO=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "nvidia-smi failed")
    echo "[GPU.ai] GPU detected: $GPU_INFO"
    DRIVER_VERSION=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1 | tr -d '[:space:]')
    # CUDA runtime version is not a --query-gpu field; parse it from the header.
    CUDA_VERSION=$(nvidia-smi 2>/dev/null | sed -n 's/.*CUDA Version: \([0-9.]*\).*/\1/p' | head -n1)
else
    echo "[GPU.ai] WARNING: nvidia-smi not found -- GPU may not be available"
    GPU_INFO="nvidia-smi not found"
fi

{{if eq .DeploymentType "vm"}}
# ============================================================
# 7b. Certified Environment Normalization (Phase 63, DeploymentType=vm)
# ============================================================
# On a VM we bootstrap the machine. Two sub-modes:
#   - Raw VM (NOT CertifiedImage): driver-floor gate ONLY. The host stays
#     otherwise untouched -- no container runtime, no toolkit, no nested
#     container. SSH lands on the host.
#   - Certified VM (CertifiedImage): driver-floor gate, then an idempotent
#     container-runtime + GPU-toolkit install, then a launch of the
#     server-pinned digest image. SSH is exposed into the container.
# Container-native (DeploymentType=container) renders NONE of this block -- the
# provider runs our image natively and nesting a container runtime is forbidden
# (Pitfall 1 / T-63-05).
{{if .DriverFloor}}
# --- Driver-floor gate (both raw and certified VMs) ---
# Compare the host driver against the certified floor using `sort -V` (version
# sort). If the host is below the floor, attempt an idempotent distro driver
# install, re-check, and on persistent failure exit with a distinct non-zero
# code so the boot fails fast inside the 10-minute provision window (T-63-03)
# rather than silently running under an unsupported driver.
DRIVER_FLOOR="{{.DriverFloor}}"
driver_meets_floor() {
    # returns 0 (true) if $1 >= DRIVER_FLOOR under version ordering.
    [ -z "$1" ] && return 1
    lowest=$(printf '%s\n%s\n' "$1" "$DRIVER_FLOOR" | sort -V | head -n1)
    [ "$1" = "$DRIVER_FLOOR" ] || [ "$lowest" = "$DRIVER_FLOOR" ]
}
if driver_meets_floor "$DRIVER_VERSION"; then
    echo "[GPU.ai] NVIDIA driver ${DRIVER_VERSION:-<none>} meets floor ${DRIVER_FLOOR}"
else
    echo "[GPU.ai] NVIDIA driver ${DRIVER_VERSION:-<none>} BELOW floor ${DRIVER_FLOOR} -- attempting install"
    if [ "$IS_CONTAINER" = false ] && command -v apt-get &>/dev/null; then
        # Idempotent, guarded best-effort install of the distro driver stack.
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -y 2>/dev/null || true
        apt-get install -y --no-install-recommends ubuntu-drivers-common 2>/dev/null || true
        if command -v ubuntu-drivers &>/dev/null; then
            ubuntu-drivers autoinstall 2>/dev/null || true
        fi
        # Re-read the driver version after the install attempt.
        if command -v nvidia-smi &>/dev/null; then
            DRIVER_VERSION=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1 | tr -d '[:space:]')
        fi
    fi
    if ! driver_meets_floor "$DRIVER_VERSION"; then
        echo "[GPU.ai] FATAL: NVIDIA driver ${DRIVER_VERSION:-<none>} still below floor ${DRIVER_FLOOR} after install attempt"
        send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"false\"}" || true
        # Distinct exit code: driver floor not satisfiable on this host.
        exit 90
    fi
fi
{{end}}
{{if .CertifiedImage}}
# --- Certified image: Docker + nvidia-container-toolkit + docker run ---
# Idempotent installs (skip when already present -- many GPU images ship Docker).
if ! command -v docker &>/dev/null; then
    echo "[GPU.ai] Installing Docker..."
    # --max-time bounds the WHOLE curl operation including its retries; the
    # apt calls the installer runs are bounded by 99gpuai-net-timeouts above.
    curl -fsSL --retry 3 --retry-delay 5 --max-time 120 https://get.docker.com | sh 2>/dev/null || true
fi
if ! dpkg -s nvidia-container-toolkit &>/dev/null; then
    echo "[GPU.ai] Installing nvidia-container-toolkit..."
    curl -fsSL --retry 3 --retry-delay 5 --max-time 60 https://nvidia.github.io/libnvidia-container/gpgkey 2>/dev/null \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg 2>/dev/null || true
    curl -s -L --retry 3 --retry-delay 5 --max-time 60 https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list 2>/dev/null \
        | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
        > /etc/apt/sources.list.d/nvidia-container-toolkit.list 2>/dev/null || true
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y 2>/dev/null || true
    apt-get install -y nvidia-container-toolkit 2>/dev/null || true
    nvidia-ctk runtime configure --runtime=docker 2>/dev/null || true
    systemctl restart docker 2>/dev/null || true
fi
# certified_gpu_live proves the GPU is usable INSIDE the container, not just on
# the host (GPU-76). A certified customer who selected a GPU environment and got
# a running container whose every CUDA call fails is worse off than a failed
# launch -- and the failure is silent, because the host's own nvidia-smi is
# perfect. Returns 0 when the container can enumerate GPUs, 1 when it cannot.
certified_gpu_live() {
    # Gate on the section-7 host detection: a certified VM on a host with no GPU
    # has no in-container GPU to prove, and must never fail on this check
    # (T-q76-03).
    if ! { command -v nvidia-smi >/dev/null 2>&1 && [ "$GPU_INFO" != "nvidia-smi not found" ]; }; then
        return 0
    fi
    CERT_GPU_ERR=""
    # Three attempts over ~10s absorb a slow container init; NVML failure is
    # sticky, so this does not paper over the real defect.
    for _try in 1 2 3; do
        if CERT_GPU_ERR=$(docker exec gpuai-certified nvidia-smi -L 2>&1) \
           && printf '%s' "$CERT_GPU_ERR" | grep -q '^GPU '; then
            return 0
        fi
        sleep 5
    done
    # Live-validated remediation: restarting the container re-applies its device
    # access. The container filesystem (and the installed SSH keys) survive a
    # restart, so this is safe to attempt once before failing loudly.
    echo "[GPU.ai] in-container NVML dead (${CERT_GPU_ERR}) -- restarting certified container once"
    docker restart gpuai-certified >/dev/null 2>&1 || true
    # Poll the same 30s window the initial start gets: a slow-restarting
    # container that would recover must not burn the launch on a fixed 5s.
    CERT_GPU_RETRY_DEADLINE=$(( $(date +%s) + 30 ))
    while [ "$(date +%s)" -lt "$CERT_GPU_RETRY_DEADLINE" ]; do
        if CERT_GPU_ERR=$(docker exec gpuai-certified nvidia-smi -L 2>&1) \
           && printf '%s' "$CERT_GPU_ERR" | grep -q '^GPU '; then
            echo "[GPU.ai] certified container GPU recovered after restart"
            return 0
        fi
        sleep 5
    done
    echo "[GPU.ai] FATAL: certified container is running but in-container NVML is dead: ${CERT_GPU_ERR}"
    return 1
}
# Run the server-pinned certified DIGEST image (never a mutable tag). SSH lands
# in the container on a normalized VM; the host sshd is retained for recovery.
PINNED_IMAGE="{{.PinnedImageRef}}"
echo "[GPU.ai] Pulling certified image ${PINNED_IMAGE}..."
# timeout bounds a pull wedged on a dark registry; a legitimate multi-GB
# layer pull finishes well inside 10 minutes on datacenter links.
timeout 600 docker pull "$PINNED_IMAGE" 2>/dev/null || true
# Publish the container's sshd on loopback :2222 only -- host sshd owns :22
# (restarted in section 3), so a host-wide publish of :22 could never bind
# (GPU-57).
# The FRP SSH proxy (section 2) targets 127.0.0.1:2222, so the authenticated
# tunnel is the ONLY route in; the VM's public IP never exposes it.
DOCKER_RUN_ERR=/var/log/gpuai-certified-run.err
# GPU-76: `--gpus all` ALONE is not enough on a systemd + cgroup-v2 host.
# The nvidia hook grants the container's GPU access by writing device-cgroup
# entries that are NOT part of the container's own device policy, so the next
# time systemd reconciles that scope -- ANY unit-state change, and THIS script
# performs several after the container starts (section 8 stops/disables/removes
# unattended-upgrades, section 9b installs the telemetry unit and runs
# `systemctl daemon-reload`) -- the entries are dropped. The container keeps
# running and keeps reporting healthy while every CUDA/NVML call inside it dies
# with "Failed to initialize NVML: Unknown Error".
# Declaring the device nodes with --device makes the permission part of the
# container's declared devices, which docker/systemd re-apply across reloads.
# Live A/B on a supplier RTX A6000 (2026-09-01; driver 580.126.09,
# toolkit 1.18.1, docker 29.1.5, cgroup v2 + systemd driver): `--gpus all`
# alone lost the GPU on the FIRST daemon-reload; `--gpus all` + these --device
# flags survived repeated reloads and unit churn.
# The globs are enumerated from the host, so a multi-GPU box passes every node
# and a CPU-only host contributes nothing (unmatched globs stay literal and
# fail the -c test) -- the flag list is simply empty there.
# /dev/nvidia-uvm is not created by nvidia-smi on every driver stack (only by
# first CUDA/UVM init) -- but customer CUDA needs it, and a hook-granted uvm
# node outside the declared policy is exactly what systemd churn drops. Ask the
# driver to create it before enumerating; harmless no-op where it exists.
nvidia-modprobe -u -c=0 2>/dev/null || true
GPU_DEVICE_FLAGS=""
for _gpudev in /dev/nvidia* /dev/nvidia-caps/*; do
    [ -c "$_gpudev" ] || continue
    GPU_DEVICE_FLAGS="$GPU_DEVICE_FLAGS --device $_gpudev"
done
echo "[GPU.ai] certified container GPU devices:${GPU_DEVICE_FLAGS:- none}"
# $GPU_DEVICE_FLAGS is intentionally unquoted: it is a flag LIST built above
# from device paths only (no user input, no spaces), and must word-split.
CONTAINER_ID=$(docker run -d --gpus all $GPU_DEVICE_FLAGS --restart unless-stopped \
    --name gpuai-certified \
    -p 127.0.0.1:2222:22 \
    -e SSH_AUTHORIZED_KEYS="$(cat /root/.ssh/authorized_keys 2>/dev/null)" \
    "$PINNED_IMAGE" 2>"$DOCKER_RUN_ERR" || echo "")
# Liveness, not existence: docker run -d prints an ID even when the container
# fails to START (GPU-57) -- e.g. a port bind conflict leaves it "created"
# forever, and --restart unless-stopped never rescues a never-started
# container. Poll for status=running with a short window to absorb slow
# entrypoints. Deliberately NOT gated on $CONTAINER_ID: a re-run against an
# already-running gpuai-certified container makes docker run fail on the name
# conflict with an empty ID, yet the environment is healthy.
CERT_LIVE_DEADLINE=$(( $(date +%s) + 30 ))
while [ "$(date +%s)" -lt "$CERT_LIVE_DEADLINE" ]; do
    if [ -n "$(docker ps -q --filter "name=^gpuai-certified$" --filter "status=running" 2>/dev/null)" ]; then
        DOCKER_UP=true
        break
    fi
    sleep 3
done
if [ "$DOCKER_UP" = true ]; then
    # The certified image's sshd reads /root/.ssh/authorized_keys but never
    # materializes SSH_AUTHORIZED_KEYS on its own, so a running container is
    # still unreachable to the customer until the keys are installed.
    # Reachable-but-unauthenticatable must not publish healthy: a failed
    # install drops to the same loud-failure branch as a dead container.
    # KEYLESS carve-out: a keyless launch (web-console-only access, allowed
    # since 2026-09) legitimately ships an EMPTY authorized_keys — skip the
    # install without demoting DOCKER_UP; the host-side ttyd console (with
    # `docker exec gpuai-certified bash` from there) is the access path.
    if ! docker exec gpuai-certified sh -c '[ -z "$SSH_AUTHORIZED_KEYS" ] || { mkdir -p /root/.ssh && printf "%s\n" "$SSH_AUTHORIZED_KEYS" > /root/.ssh/authorized_keys && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys; }'; then
        echo "[GPU.ai] certified container is running but SSH key install failed"
        DOCKER_UP=false
    fi
fi
if [ "$DOCKER_UP" = true ]; then
    # Running + reachable is not enough for a GPU environment: prove NVML works
    # inside the container. A failure demotes DOCKER_UP into the same loud
    # branch as a dead container (GPU-76 extends the GPU-57 idiom).
    if ! certified_gpu_live; then
        DOCKER_UP=false
    fi
fi
if [ "$DOCKER_UP" = true ]; then
    # The pinned ref is itself the server-controlled digest; record it for the
    # env-report callback (docker inspect RepoDigests is best-effort/optional).
    CERTIFIED_IMAGE_DIGEST="$PINNED_IMAGE"
    echo "[GPU.ai] Certified container running: ${CONTAINER_ID}"
else
    echo "[GPU.ai] FATAL: certified container failed to start or accept SSH keys"
    [ -s "$DOCKER_RUN_ERR" ] && sed 's/^/[GPU.ai] docker run stderr: /' "$DOCKER_RUN_ERR" 2>/dev/null
    docker ps -a --filter "name=^gpuai-certified$" 2>/dev/null || true
    docker logs --tail 20 gpuai-certified 2>&1 | sed 's/^/[GPU.ai] container log: /' || true
    CONTAINER_ID=""
    # Mirror the driver-floor failure idiom (exit 90 above): report failure so
    # the server never publishes this instance as a healthy certified env,
    # then exit with a distinct code inside the provisioning window. The
    # customer selected certified; silently landing them on the host VM is
    # worse than a failed launch.
    send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"false\"}" || true
    exit 91
fi
{{end}}
{{if .CustomerImageRef}}
# ============================================================
# 7c. Customer Image Workload (custom images Phase 3)
# ============================================================
# Docker-run the customer's DIGEST-PINNED image beside the host's sshd +
# tunnel — the SSH contract on VM capacity: the host is the management plane
# (SSH lands here), the customer container is the workload (inspect it with
# `docker logs gpuai-workload` / `docker exec`). Install + GPU-device +
# liveness idioms mirror the certified block above (GPU-57/76) — duplicated
# deliberately rather than restructuring that hardened path. Typed failures:
# exit 92 = image pull failed, exit 93 = workload failed to start — both
# after a docker_up=false callback so the server never publishes a healthy
# instance whose selected workload is not actually running.
if ! command -v docker &>/dev/null; then
    echo "[GPU.ai] Installing Docker..."
    curl -fsSL --retry 3 --retry-delay 5 --max-time 120 https://get.docker.com | sh 2>/dev/null || true
fi
if ! dpkg -s nvidia-container-toolkit &>/dev/null; then
    echo "[GPU.ai] Installing nvidia-container-toolkit..."
    curl -fsSL --retry 3 --retry-delay 5 --max-time 60 https://nvidia.github.io/libnvidia-container/gpgkey 2>/dev/null \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg 2>/dev/null || true
    curl -s -L --retry 3 --retry-delay 5 --max-time 60 https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list 2>/dev/null \
        | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
        > /etc/apt/sources.list.d/nvidia-container-toolkit.list 2>/dev/null || true
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y 2>/dev/null || true
    apt-get install -y nvidia-container-toolkit 2>/dev/null || true
    nvidia-ctk runtime configure --runtime=docker 2>/dev/null || true
    systemctl restart docker 2>/dev/null || true
fi
CUSTOMER_IMAGE="{{.CustomerImageRef}}"
echo "[GPU.ai] Pulling customer image ${CUSTOMER_IMAGE}..."
# 600s: matches the certified pull bound — the whole 7c sequence (docker +
# toolkit install + pull + liveness) must fit the engine's provisioning
# budget floor (~10 min), or a fat image gets reaped mid-pull every time.
if ! timeout 600 docker pull "$CUSTOMER_IMAGE" 2>/var/log/gpuai-workload-pull.err; then
    echo "[GPU.ai] FATAL: customer image pull failed"
    [ -s /var/log/gpuai-workload-pull.err ] && tail -5 /var/log/gpuai-workload-pull.err | sed 's/^/[GPU.ai] docker pull: /'
    send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"false\"}" || true
    # Distinct exit code: customer image pull failed (auth/network/registry).
    exit 92
fi
# GPU-76: declared --device flags so systemd unit churn can't drop GPU access.
nvidia-modprobe -u -c=0 2>/dev/null || true
GPU_DEVICE_FLAGS=""
for _gpudev in /dev/nvidia* /dev/nvidia-caps/*; do
    [ -c "$_gpudev" ] || continue
    GPU_DEVICE_FLAGS="$GPU_DEVICE_FLAGS --device $_gpudev"
done
{{if .CustomerEnvB64}}
# Env rides a root-only file into docker --env-file; never shell-interpolated.
printf '%s' "{{.CustomerEnvB64}}" | base64 -d > /etc/gpuai-workload.env
chmod 600 /etc/gpuai-workload.env
{{end}}
# Effective entrypoint/args: NUL-delimited b64 arrays — argument bytes never
# enter shell source; read into bash arrays and passed positionally.
GPUAI_ENTRY=()
{{if .CustomerEntrypointB64}}
# Elements are NUL-TERMINATED server-side (element+NUL each), so no trailing
# terminator is appended here — appending one would fabricate an extra empty
# element and break the --entrypoint "" (clear) idiom.
while IFS= read -r -d '' _a; do GPUAI_ENTRY+=("$_a"); done < <(printf '%s' "{{.CustomerEntrypointB64}}" | base64 -d)
{{end}}
GPUAI_ARGS=()
{{if .CustomerArgsB64}}
while IFS= read -r -d '' _a; do GPUAI_ARGS+=("$_a"); done < <(printf '%s' "{{.CustomerArgsB64}}" | base64 -d)
{{end}}
# --restart on-failure:3, NOT unless-stopped: an arbitrary workload may exit
# cleanly (a bash CMD with no tty), and unless-stopped would restart-loop it
# forever; on-failure retries real crashes a few times and leaves clean exits
# alone. Declared ports publish on LOOPBACK only — the frpc app vhost serves
# the primary and SSH tunneling reaches the rest; nothing on the public IP.
GPUAI_RUN_FLAGS=(-d --gpus all --restart on-failure:3 --name gpuai-workload)
for _f in $GPU_DEVICE_FLAGS; do GPUAI_RUN_FLAGS+=("$_f"); done
[ -f /etc/gpuai-workload.env ] && GPUAI_RUN_FLAGS+=(--env-file /etc/gpuai-workload.env)
{{range .CustomerPorts}}GPUAI_RUN_FLAGS+=(-p 127.0.0.1:{{.}}:{{.}})
{{end}}
if [ ${#GPUAI_ENTRY[@]} -gt 0 ]; then
    GPUAI_RUN_FLAGS+=(--entrypoint "${GPUAI_ENTRY[0]}")
    GPUAI_ARGS=("${GPUAI_ENTRY[@]:1}" "${GPUAI_ARGS[@]}")
fi
docker run "${GPUAI_RUN_FLAGS[@]}" "$CUSTOMER_IMAGE" "${GPUAI_ARGS[@]}" 2>/var/log/gpuai-workload-run.err || true
# Liveness, not existence (the GPU-57 idiom): poll for status=running.
WORKLOAD_UP=false
WORKLOAD_DEADLINE=$(( $(date +%s) + 45 ))
while [ "$(date +%s)" -lt "$WORKLOAD_DEADLINE" ]; do
    if [ -n "$(docker ps -q --filter "name=^gpuai-workload$" --filter "status=running" 2>/dev/null)" ]; then
        WORKLOAD_UP=true
        break
    fi
    sleep 3
done
if [ "$WORKLOAD_UP" = true ]; then
    DOCKER_UP=true
    CONTAINER_ID=$(docker ps -q --filter "name=^gpuai-workload$" 2>/dev/null | head -n1)
    echo "[GPU.ai] Customer workload running: ${CONTAINER_ID}"
else
    # A workload that ran and exited CLEANLY (a shell CMD, a one-shot job) is
    # not a failure — the customer keeps their SSH environment. Distinguish it
    # from never-started via docker inspect; the braces are shell-assembled so
    # the Go template never sees them.
    _LB='{{"{{"}}'; _RB='{{"}}"}}'
    STARTED_AT=$(docker inspect -f "${_LB}.State.StartedAt${_RB}" gpuai-workload 2>/dev/null || echo "")
    EXIT_CODE=$(docker inspect -f "${_LB}.State.ExitCode${_RB}" gpuai-workload 2>/dev/null || echo "")
    if [ -n "$STARTED_AT" ] && [ "$STARTED_AT" != "0001-01-01T00:00:00Z" ] && [ "$EXIT_CODE" = "0" ]; then
        DOCKER_UP=true
        CONTAINER_ID=$(docker ps -aq --filter "name=^gpuai-workload$" 2>/dev/null | head -n1)
        echo "[GPU.ai] Customer workload ran and exited cleanly — SSH environment remains"
    else
        echo "[GPU.ai] FATAL: customer workload failed to start (exit code ${EXIT_CODE:-unknown})"
        [ -s /var/log/gpuai-workload-run.err ] && sed 's/^/[GPU.ai] docker run stderr: /' /var/log/gpuai-workload-run.err
        docker logs --tail 20 gpuai-workload 2>&1 | sed 's/^/[GPU.ai] workload log: /' || true
        send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"false\"}" || true
        # Distinct exit code: customer workload failed to start.
        exit 93
    fi
fi
{{end}}
{{end}}

# ============================================================
# 8. Disable Unattended Upgrades (skip in containers)
# ============================================================
if [ "$IS_CONTAINER" = false ]; then
    systemctl stop unattended-upgrades 2>/dev/null || true
    systemctl disable unattended-upgrades 2>/dev/null || true
    apt-get remove -y unattended-upgrades 2>/dev/null || true
fi

cat > /etc/apt/apt.conf.d/99gpu-ai-no-auto-update << 'APTEOF'
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::AutocleanInterval "0";
APTEOF

# ============================================================
# 8b. Start the app + wait for it to be ready (service templates)
# ============================================================
# APP_READY defaults to true so raw (SSH-only) instances report ready
# immediately; the app-port conditional below flips it to a polled value
# only for service templates (preserves raw-instance behavior).
APP_READY=true
{{if .AppPort}}
# The curated fat image bakes the app start at /gpuai/start-app.sh (Pitfall 1:
# dockerArgs shadows the image CMD, so the bootstrap must launch the app).
if [ -x /gpuai/start-app.sh ]; then
    echo "[GPU.ai] Starting app via /gpuai/start-app.sh..."
    nohup /gpuai/start-app.sh > /var/log/gpuai-app.log 2>&1 &
fi
echo "[GPU.ai] Waiting for app on :{{.AppPort}} (timeout {{.AppReadyTimeout}}s)..."
APP_READY=false
DEADLINE=$(( $(date +%s) + {{.AppReadyTimeout}} ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:{{.AppPort}}/" --max-time 3 || echo 000)
    if [ "$code" -ge 200 ] && [ "$code" -lt 500 ]; then APP_READY=true; break; fi
    sleep 5
done
echo "[GPU.ai] App readiness: APP_READY=${APP_READY}"
{{end}}

# ============================================================
# 9. Ready Callback
# ============================================================
# RAWREADY: tunnel_up must mean "a customer's `ssh -p {{.RemotePort}}` will
# connect RIGHT NOW", not "the frpc binary downloaded". The gateway only opens
# this instance's public SSH port once frpc registers, so probing that port
# from here (hairpin via the gateway's public address, same path as the egress
# gate) is an end-to-end proof. The server defers booting->running on
# tunnel_up=false, so a wrong "true" here recreates the dead-tunnel-but-
# Running bug this exists to prevent.
probe_tunnel() {
    timeout 4 bash -c 'echo > /dev/tcp/{{.ProxyHost}}/{{.RemotePort}}' 2>/dev/null
}
TUNNEL_UP=false
if [ "$FRPC_DOWNLOADED" = true ]; then
    # frpc normally registers within ~1s of starting (egress is already
    # gated above); 90s absorbs a slow gateway without stalling the boot.
    TUNNEL_DEADLINE=$(( $(date +%s) + 90 ))
    while [ "$(date +%s)" -lt "$TUNNEL_DEADLINE" ]; do
        if probe_tunnel; then TUNNEL_UP=true; break; fi
        sleep 3
    done
fi
echo "[GPU.ai] Tunnel reachability: TUNNEL_UP=${TUNNEL_UP}"
{{if and .CertifiedImage (eq .DeploymentType "vm")}}
# GPU-76 re-check, immediately before the callback that PUBLISHES this instance
# as healthy. Everything between the container start and here can revoke the
# container's GPU (section 8 stops/disables/removes unattended-upgrades, which
# makes systemd reconcile the container scope's device policy). The --device
# flags on the docker run are what prevent that; this is the guard that makes
# the failure impossible to publish if anything ever gets past them.
if [ "$DOCKER_UP" = true ] && ! certified_gpu_live; then
    DOCKER_UP=false
    echo "[GPU.ai] FATAL: certified container lost GPU access after boot-time system changes"
    send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"false\"}" || true
    exit 91
fi
{{end}}
{{if or .GPUCheckMode .ProbeURL}}
# workload_python SECONDS [ARGS...] < script runs python3 where the customer's
# workload runs: the certified container on VMs, the workload container for
# customer images, in place on container providers. Exit 127 means there is no
# python3 there (some customer images), which callers treat as skipped; 124
# means it timed out.
#
# A timed-out check must not live on. In place, timeout signals its whole
# process group. Through docker exec it only kills the docker client, and the
# check would keep running inside the container, holding a context on every
# GPU in the customer's environment. So the in-container shell records its pid,
# which is the check's own once it execs python3 (the check starts no children),
# and a timeout kills it with shell builtins only, so any image with sh works.
# That kill is itself bounded, so a wedged docker cannot stall the bootstrap.
workload_python() {
    _wp_secs=$1
    shift
{{- if or (and .CertifiedImage (eq .DeploymentType "vm")) .CustomerImageRef}}
    _wp_c=gpuai-{{if and .CertifiedImage (eq .DeploymentType "vm")}}certified{{else}}workload{{end}}
    timeout "$_wp_secs" docker exec -i $_wp_c sh -c 'command -v python3 >/dev/null 2>&1 || exit 127; echo $$ >/tmp/gpuai-gpucheck.pid; exec python3 - "$@"' python3 "$@"
    _wp_rc=$?
    [ $_wp_rc = 124 ] && timeout 10 docker exec $_wp_c sh -c 'read p </tmp/gpuai-gpucheck.pid && kill -9 $p' 2>/dev/null
    return $_wp_rc
{{- else}}
    command -v python3 >/dev/null 2>&1 || return 127
    timeout "$_wp_secs" python3 - "$@"
{{- end}}
}
{{end}}
{{if .GPUCheckMode}}
# ============================================================
# 8b. Startup GPU compute check
# ============================================================
# nvidia-smi only proves NVML answers. Two failures customers hit pass it: a
# host whose nvidia-uvm path is broken (cuInit 999, every CUDA call fails) and
# a framework build with no kernels for the GPU's architecture. This runs a
# real kernel on every GPU through the CUDA driver (PTX, so no toolkit or
# framework is needed), then a matmul through PyTorch when it is installed,
# inside the environment the customer lands in. In "enforce" mode a failed
# check is never published: the deferred callback carries the reason, and the
# engine releases this host and relaunches elsewhere before billing starts (a
# host failure), or fails the launch outright (the promised framework cannot
# use the GPU, which another host would not change). In "shadow" mode it runs
# only after the ready callback (see below), so it never delays readiness.
GPU_CHECK=skipped
GPU_CHECK_DETAIL="the check could not run in this environment"
GPU_CHECK_SEEN=""
# The script below ships byte for byte (a startup-script minifier never touches
# heredoc bodies), so it carries no comments. Arguments to libcuda are passed
# as explicit ctypes values (c_size_t for sizes, c_uint64 for device pointers)
# instead of declaring argtypes, which keeps it short. It prints one line,
# GPUCHECK|ok-or-fail|detail|GPUs seen, with the detail reduced to characters
# that are safe inside the JSON callback. The PTX kernel writes out[i] = 2i + 1
# and is read back and compared; PTX for sm_50 is JIT-compiled by the driver
# for whatever architecture is installed, Blackwell included. Host failures
# say "host:", a broken framework says "environment:".
cat > /tmp/gpuai-gpucheck.py <<'GPUCHECKEOF'
import ctypes as C, os, re, sys
A = sys.argv + ["", ""]
EXPECT = int(A[1]) if A[1].isdigit() else 0
FRAMEWORK = A[2]
def done(result, detail="", seen=""):
    print("GPUCHECK|%s|%s|%s" % (result, re.sub(r"[^\w .,:;=/()+-]", "", str(detail), flags=re.A)[:160], seen))
    sys.exit(0)
def uvm():
    try:
        os.close(os.open("/dev/nvidia-uvm", os.O_RDWR))
        return ""
    except OSError as e:
        return ", nvidia-uvm open: " + os.strerror(e.errno)
try:
    cu = C.CDLL("libcuda.so.1")
except OSError:
    done("fail", "host: libcuda.so.1 is not loadable")
rc = cu.cuInit(0)
if rc:
    done("fail", "host: cuInit returned %d%s" % (rc, uvm()))
count = C.c_int()
if cu.cuDeviceGetCount(C.byref(count)) or not count.value:
    done("fail", "host: no CUDA devices visible", "0")
seen = str(count.value)
if EXPECT and count.value < EXPECT:
    done("fail", "host: %d of %d GPUs visible" % (count.value, EXPECT), seen)
PTX = b""".version 7.0
.target sm_50
.address_size 64
.visible .entry fill(.param .u64 p_out)
{
.reg .b32 %r<5>;
.reg .f32 %f<3>;
.reg .b64 %rd<4>;
ld.param.u64 %rd1, [p_out];
mov.u32 %r1, %ctaid.x;
mov.u32 %r2, %ntid.x;
mov.u32 %r3, %tid.x;
mad.lo.s32 %r4, %r1, %r2, %r3;
cvt.rn.f32.u32 %f1, %r4;
fma.rn.f32 %f2, %f1, 0f40000000, 0f3F800000;
cvta.to.global.u64 %rd2, %rd1;
mul.wide.u32 %rd3, %r4, 4;
add.s64 %rd2, %rd2, %rd3;
st.global.f32 [%rd2], %f2;
ret;
}
"""
N = 1 << 20
SIZE = C.c_size_t(N * 4)
def check(result, what):
    if result:
        raise RuntimeError("%s returned %d" % (what, result))
for i in range(count.value):
    dev, ctx, mod, kernel, buf = C.c_int(), C.c_void_p(), C.c_void_p(), C.c_void_p(), C.c_uint64()
    try:
        check(cu.cuDeviceGet(C.byref(dev), i), "device lookup")
        check(cu.cuDevicePrimaryCtxRetain(C.byref(ctx), dev), "context")
        check(cu.cuCtxSetCurrent(ctx), "context")
        check(cu.cuModuleLoadData(C.byref(mod), PTX), "module load")
        check(cu.cuModuleGetFunction(C.byref(kernel), mod, b"fill"), "kernel lookup")
        check(cu.cuMemAlloc_v2(C.byref(buf), SIZE), "allocation")
        params = (C.c_void_p * 1)(C.cast(C.byref(buf), C.c_void_p))
        check(cu.cuLaunchKernel(kernel, N // 256, 1, 1, 256, 1, 1, 0, None, params, None), "launch")
        check(cu.cuCtxSynchronize(), "kernel")
        out = (C.c_float * N)()
        check(cu.cuMemcpyDtoH_v2(out, buf, SIZE), "copy back")
        cu.cuMemFree_v2(buf)
        wrong = sum(1 for k in range(0, N, 1021) if out[k] != 2.0 * k + 1.0)
        if wrong:
            raise RuntimeError("%d wrong results" % wrong)
    except RuntimeError as e:
        done("fail", "host: GPU %d compute check failed: %s%s" % (i, e, uvm()), seen)
try:
    import torch
except Exception:
    if FRAMEWORK == "pytorch":
        done("fail", "environment: pytorch is not installed", seen)
    done("ok", "", seen)
try:
    if not torch.cuda.is_available():
        done("fail", "environment: torch %s cannot use the GPU" % torch.__version__, seen)
    for i in range(torch.cuda.device_count()):
        x = torch.ones(256, 256, device="cuda:%d" % i)
        if abs(float((x @ x).sum()) - 256.0 ** 3) > 1e3:
            done("fail", "environment: torch matmul wrong on GPU %d" % i, seen)
except Exception as e:
    msg = str(e).strip()
    done("fail", "environment: torch %s cuda %s: %s" % (torch.__version__, torch.version.cuda, msg.splitlines()[0] if msg else type(e).__name__), seen)
done("ok", "", seen)
GPUCHECKEOF
# gpu_check SECONDS TRIES runs the check within SECONDS of wall time in all and
# sets GPU_CHECK (ok, fail, warn or skipped), GPU_CHECK_DETAIL and
# GPU_CHECK_SEEN. Only a host failure that answered is retried, 10s apart and
# only while the budget lasts: the UVM node can lag the first seconds of boot.
# A timeout is never retried (a check that hung has spent the budget and would
# hang again), nor is an environment failure (a retry will not change the
# image).
gpu_check() {
    [ "$GPU_INFO" != "nvidia-smi not found" ] || return 0
    _gpu_end=$((SECONDS + $1))
    _gpu_try=1
    while :; do
        _gpu_secs=$((_gpu_end - SECONDS))
        workload_python $_gpu_secs {{.ExpectedGPUCount}} '{{.ExpectFramework}}' < /tmp/gpuai-gpucheck.py > /tmp/gpuai-gpucheck.out 2>/dev/null
        _gpu_rc=$?
        _gpu_line=$(grep '^GPUCHECK|' /tmp/gpuai-gpucheck.out 2>/dev/null | tail -n1)
        if [ -n "$_gpu_line" ]; then
            IFS='|' read -r _gpu_tag GPU_CHECK GPU_CHECK_DETAIL GPU_CHECK_SEEN <<< "$_gpu_line"
        elif [ "$_gpu_rc" -eq 124 ]; then
            GPU_CHECK=fail
            GPU_CHECK_DETAIL="host: compute check did not finish in ${_gpu_secs}s"
            break
        else
            GPU_CHECK=skipped
            GPU_CHECK_DETAIL="the check could not run in this environment (exit ${_gpu_rc})"
        fi
        case "$GPU_CHECK:$GPU_CHECK_DETAIL" in fail:host:*) ;; *) break ;; esac
        [ $((_gpu_try += 1)) -le $2 ] && [ $((_gpu_end - SECONDS)) -gt 10 ] || break
        sleep 10
    done
{{- if not .ExpectFramework}}
    # The environment promised no framework, so one the image merely carries
    # that cannot use the GPU (a CPU-only torch, say) is the image's business,
    # not a fault of this host and not ours to refuse: it is reported as a
    # warning and never blocks. Before this, enforce mode refused every host
    # for such an image.
    case "$GPU_CHECK:$GPU_CHECK_DETAIL" in fail:environment:*) GPU_CHECK=warn ;; esac
{{- end}}
    echo "[GPU.ai] GPU compute check: ${GPU_CHECK} ${GPU_CHECK_DETAIL}"
}
{{- if eq .GPUCheckMode "enforce"}}
# Enforce: the check gates the ready callback, so it runs before it, bounded in
# all by GPUCheckEnforceSeconds. The tunnel-stall watchdog runs until the
# callback lands, so the engine widens that window by the same bound.
gpu_check {{gpuCheckSeconds "enforce"}} 3
if [ "$GPU_CHECK" = fail ]; then
    echo "[GPU.ai] FATAL: GPU compute check failed -- not publishing this instance"
    # send_callback already retries (5 attempts, 15s apart, each bounded by
    # curl --max-time). If every attempt fails the verdict is lost, which is
    # safe: the instance never reaches running, so it is never billed, and the
    # boot watchdog or provisioning timeout releases it.
    send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"\", \"container_id\": \"\", \"docker_up\": \"${DOCKER_UP}\", \"gpu_check\": \"fail\", \"gpu_check_detail\": \"${GPU_CHECK_DETAIL}\", \"gpu_check_mode\": \"enforce\", \"gpus_seen\": \"${GPU_CHECK_SEEN}\"}" || true
    exit 94
fi
{{- end}}
{{end}}
{{if .ProbeURL}}
# ============================================================
# 8c. Fleet probe (internal measurement launches only)
# ============================================================
# Rendered only for launches the fleet prober makes to measure an offering.
# Downloads the on-host probe (it is too large to ride inside this script on
# providers that cap startup-script size), runs it where a customer's workload would run and posts its JSON
# report to the same URL. Never blocks the ready callback: the prober reads
# the report, scores it, and terminates the instance itself.
curl -fsS '{{.ProbeURL}}' -H 'Authorization: Bearer {{.InternalToken}}' \
    --retry 3 --retry-delay 5 --max-time 30 -o /tmp/gpuai-probe.py || : > /tmp/gpuai-probe.py
workload_python 180 < /tmp/gpuai-probe.py > /tmp/gpuai-probe.json 2>/tmp/gpuai-probe.err
_probe_rc=$?
if [ ! -s /tmp/gpuai-probe.py ]; then
    printf '{"probe_version": 0, "errors": {"probe": "the probe could not be downloaded"}}' > /tmp/gpuai-probe.json
elif ! grep -q '^{' /tmp/gpuai-probe.json 2>/dev/null; then
    printf '{"probe_version": 0, "errors": {"probe": "the probe exited %s without a report"}}' "$_probe_rc" > /tmp/gpuai-probe.json
fi
curl -fsS -X POST '{{.ProbeURL}}' \
    -H 'Authorization: Bearer {{.InternalToken}}' \
    -H 'Content-Type: application/json' \
    --data-binary @/tmp/gpuai-probe.json \
    --retry 3 --retry-delay 5 --max-time 30 >/dev/null || echo "[GPU.ai] WARNING: fleet probe report POST failed"
{{end}}
echo "[GPU.ai] Sending ready callback..."
# READY_CB_OK records whether the initial delivery landed. On failure the
# late re-POST loop below (which now also arms on a failed callback, not
# just a late tunnel) keeps re-sending once the API is reachable again --
# without that, an API-side egress blackout at this exact moment would
# strand the instance at "booting" even with a healthy tunnel.
READY_CB_OK=true
send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"${TUNNEL_UP}\", \"app_ready\": \"${APP_READY}\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"${CERTIFIED_IMAGE_DIGEST}\", \"container_id\": \"${CONTAINER_ID}\", \"docker_up\": \"${DOCKER_UP}\"{{if eq .GPUCheckMode "enforce"}}, \"gpu_check\": \"${GPU_CHECK}\", \"gpu_check_detail\": \"${GPU_CHECK_DETAIL}\", \"gpu_check_mode\": \"enforce\", \"gpus_seen\": \"${GPU_CHECK_SEEN}\"{{end}}}" || {
    READY_CB_OK=false
    echo "[GPU.ai] WARNING: Ready callback failed -- background re-send loop will keep trying"
}
{{- if eq .GPUCheckMode "shadow"}}

# Shadow: the check runs only after the ready callback, in the background, so
# it adds no latency to readiness (the tunnel-stall watchdog clock runs
# until the callback lands) and cannot change status. One try, within
# GPUCheckShadowSeconds. The result goes to the ready report as a report_only
# POST; tunnel_up=false rides along so that even a server that does not know
# report_only (an older gpuctl task mid-deploy) defers instead of flipping it.
(
    gpu_check {{gpuCheckSeconds "shadow"}} 1
    send_callback "{\"tunnel_up\": \"false\", \"app_ready\": \"false\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"docker_up\": \"${DOCKER_UP}\", \"gpu_check\": \"${GPU_CHECK}\", \"gpu_check_detail\": \"${GPU_CHECK_DETAIL}\", \"gpu_check_mode\": \"shadow\", \"gpus_seen\": \"${GPU_CHECK_SEEN}\", \"report_only\": \"true\"}"
) &
{{- end}}

{{if .AppPort}}
# MD-03: if the app was NOT ready within the initial deadline, the callback above
# reported app_ready=false and the server-side gate (handlers_internal.go) left
# the instance in "booting" WITHOUT transitioning -- by design, expecting a later
# re-POST. Implement that re-POST: keep probing the app in the BACKGROUND and,
# once it answers 2xx-4xx, re-send the callback with app_ready=true so the
# instance finally flips to running. Without this a slow-booting app (model load
# exceeding ready_timeout_seconds) fires app_ready=false once and sticks in
# "booting" forever. Backgrounded so it never blocks sshd/keepalive below;
# bounded by a generous outer deadline so the probe cannot run unbounded.
if [ "$APP_READY" != "true" ]; then
    (
        RECHECK_DEADLINE=$(( $(date +%s) + {{.AppReadyTimeout}} * 4 ))
        while [ "$(date +%s)" -lt "$RECHECK_DEADLINE" ]; do
            sleep 10
            code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:{{.AppPort}}/" --max-time 3 || echo 000)
            if [ "$code" -ge 200 ] && [ "$code" -lt 500 ]; then
                # Re-probe the tunnel at send time: the server also gates on
                # tunnel_up, and the value captured at the initial callback
                # may be stale by now (frpc registers independently).
                TUNNEL_NOW=false
                probe_tunnel && TUNNEL_NOW=true
                echo "[GPU.ai] App became ready late -- re-sending ready callback (app_ready=true, tunnel_up=${TUNNEL_NOW})..."
                # break ONLY on delivered send: on failure the loop comes
                # back around (the app stays ready) and tries again until
                # the outer deadline, instead of dropping the re-POST.
                if send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"${TUNNEL_NOW}\", \"app_ready\": \"true\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"${CERTIFIED_IMAGE_DIGEST}\", \"container_id\": \"${CONTAINER_ID}\", \"docker_up\": \"${DOCKER_UP}\"}"; then
                    break
                fi
            fi
        done
    ) &
fi
{{end}}

# RAWREADY late re-POST (mirror of MD-03 for the tunnel signal). Arms in two
# cases: (a) the tunnel was NOT reachable within the initial 90s -- the
# callback above carried tunnel_up=false and the server left the instance in
# "booting" by design, expecting a later re-POST once frpc (supervised, so it
# keeps retrying its login independently) registers; (b) the initial callback
# itself failed to DELIVER (READY_CB_OK=false) -- egress to the API can be
# dark while the tunnel is fine, and without a re-send the instance would
# strand at "booting" despite a working tunnel. Each round re-probes the
# tunnel and only stops once a callback actually lands. Bounded: the engine
# errors the instance at its provisioning timeout anyway, so probing much
# longer than that only wastes cycles.
if [ "$FRPC_DOWNLOADED" = true ] && { [ "$TUNNEL_UP" != "true" ] || [ "$READY_CB_OK" != "true" ]; }; then
    (
        TUNNEL_REPROBE_DEADLINE=$(( $(date +%s) + 900 ))
        while [ "$(date +%s)" -lt "$TUNNEL_REPROBE_DEADLINE" ]; do
            sleep 10
            if probe_tunnel; then
                echo "[GPU.ai] Tunnel reachable -- re-sending ready callback (tunnel_up=true)..."
                # break ONLY on delivered send; otherwise keep looping and
                # try again next round until the deadline.
                if send_callback "{\"gpu_info\": \"${GPU_INFO}\", \"tunnel_up\": \"true\", \"app_ready\": \"${APP_READY}\", \"driver_version\": \"${DRIVER_VERSION}\", \"cuda_version\": \"${CUDA_VERSION}\", \"certified_image_digest\": \"${CERTIFIED_IMAGE_DIGEST}\", \"container_id\": \"${CONTAINER_ID}\", \"docker_up\": \"${DOCKER_UP}\"}"; then
                    break
                fi
            fi
        done
    ) &
fi

{{if .TelemetryURL}}
# ============================================================
# 9b. Recurring GPU telemetry sampler (TELEM-01)
# ============================================================
# cloud-init runs this script ONCE (RESEARCH Pitfall 5), so a one-shot line
# would sample only at boot. Run a backgrounded while-loop that samples
# nvidia-smi every 2 min and POSTs util/VRAM/power to the telemetry ingest
# endpoint, supervised like frpc (systemd unit on VMs, respawn loop in
# containers) so it survives crashes for the pod's life. Guarded on
# `command -v nvidia-smi` (the existing GPU_INFO idiom) so a CPU/driver-less
# image no-ops instead of crashing. The per-instance InternalToken is the same
# secret already used for the ready callback (no new exposure).
if command -v nvidia-smi &>/dev/null; then
    # The sampler loop body, written to a script so both supervision paths run
    # the identical logic.
    cat > /usr/local/bin/gpuai-telemetry.sh << 'TELEOF'
#!/bin/bash
while true; do
    SAMPLE=$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,power.draw \
             --format=csv,noheader,nounits 2>/dev/null | head -1)
    # --max-time bounds the whole operation INCLUDING retries, keeping the
    # worst case (60s) well under the 120s sampling cadence; a sample that
    # still fails is simply superseded by the next one.
    curl -s -X POST '{{.TelemetryURL}}' \
        -H 'Authorization: Bearer {{.InternalToken}}' \
        -H 'Content-Type: application/json' \
        -d "{\"sample\":\"${SAMPLE}\"}" \
        --retry 3 --retry-delay 5 --max-time 60 || true
    sleep 120
done
TELEOF
    chmod +x /usr/local/bin/gpuai-telemetry.sh

    TELEMETRY_SUPERVISED=false
    if [ "$IS_CONTAINER" = false ] && command -v systemctl > /dev/null 2>&1; then
        cat > /etc/systemd/system/gpuai-telemetry.service << 'TELUNITEOF'
[Unit]
Description=GPU.ai in-pod telemetry sampler
After=network-online.target

[Service]
ExecStart=/usr/local/bin/gpuai-telemetry.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
TELUNITEOF
        if systemctl daemon-reload 2>/dev/null && \
           systemctl enable --now gpuai-telemetry 2>/dev/null; then
            TELEMETRY_SUPERVISED=true
        fi
    fi
    if [ "$TELEMETRY_SUPERVISED" = false ]; then
        # Container (or systemd unavailable): background respawn loop. The
        # sampler script already loops; this outer loop restarts it if it ever
        # exits (e.g. nvidia-smi transiently disappears).
        nohup bash -c 'while true; do
            /usr/local/bin/gpuai-telemetry.sh >> /var/log/gpuai-telemetry.log 2>&1
            echo "[GPU.ai] telemetry sampler exited, restarting in 10s..." >> /var/log/gpuai-telemetry.log
            sleep 10
        done' > /dev/null 2>&1 &
    fi
    echo "[GPU.ai] telemetry sampler started"
fi
{{end}}

{{if .CustomStartB64}}
# ============================================================
# 9c. Custom Image Workload (custom-images Phase 1)
# ============================================================
# Launch the customer image's own ENTRYPOINT/CMD (captured server-side by the
# registry pre-flight and rendered into a quoted exec script) now that sshd,
# the tunnel, and telemetry are up — the SSH contract: the bootstrap owns
# PID 1, the customer's process runs beside it. Backgrounded via setsid so a
# crashing workload never takes down the tunnel; its output lands in
# /var/log/gpuai-entrypoint.log for the customer to inspect over SSH.
# Container mode only: on a VM this script is root on the HOST, where the
# customer workload must not run (that is Phase 3's docker-run path).
if [ "$IS_CONTAINER" = true ]; then
    echo "{{.CustomStartB64}}" | base64 -d > /usr/local/bin/gpuai-image-entrypoint.sh
    chmod +x /usr/local/bin/gpuai-image-entrypoint.sh
    echo "[GPU.ai] Starting image entrypoint (log: /var/log/gpuai-entrypoint.log)..."
    setsid nohup /usr/local/bin/gpuai-image-entrypoint.sh >> /var/log/gpuai-entrypoint.log 2>&1 &
fi
{{end}}

echo "[GPU.ai] Bootstrap complete"

# ============================================================
# 10. Keep Container Alive
# ============================================================
# When running as dockerArgs in a container, this script IS the main process (PID 1).
# If it exits, the container stops. Run sshd in the background and use sleep infinity
# as the foreground process to keep PID 1 alive.
if [ "$IS_CONTAINER" = true ]; then
    echo "[GPU.ai] Container mode: starting sshd and keeping alive..."
    # Start sshd in background (not exec, so PID 1 survives if sshd fails)
    /usr/sbin/sshd -e 2>&1 || true
    # sleep infinity keeps PID 1 alive so the container never exits
    exec sleep infinity
fi
