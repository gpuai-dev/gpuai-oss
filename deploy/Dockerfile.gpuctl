# gpuctl server image. Build from the repository root:
#   docker build -f deploy/Dockerfile.gpuctl -t gpuai-oss-gpuctl .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY openapi ./openapi
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/gpuctl ./cmd/gpuctl

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gpuctl /usr/local/bin/gpuctl
# 8080: API. 7000: frps, only used when FRP_TOKEN enables the tunnel.
EXPOSE 8080 7000
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/gpuctl"]
CMD ["serve"]
