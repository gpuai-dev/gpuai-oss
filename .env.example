# GPU.ai Open Source: gpuctl configuration.
#
# Copy to deploy/.env and edit. deploy/docker-compose.yml reads it from there and
# supplies DATABASE_URL, REDIS_URL and a mock supplier itself, so for the
# quickstart every line below can stay commented out. Values shown are the
# defaults. Full reference: docs/configuration.md.

# ---------------------------------------------------------------------------
# Required (set by docker-compose; set them yourself when running gpuctl
# directly)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Migrations apply at startup.
# DATABASE_URL=postgres://gpuai:gpuai-local-dev@localhost:5432/gpuai?sslmode=disable

# Redis connection string: live offerings cache and per-key rate limits.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP listen port inside the container / on the host when run directly.
# GPUCTL_PORT=8080

# Host port docker-compose publishes gpuctl on (127.0.0.1 only).
# GPUCTL_HOST_PORT=8080

# Deployment name, stamped onto upstream resource names so two deployments
# sharing one supplier account never reconcile each other's instances away.
# GPUCTL_ENV=development

# Externally reachable base URL of this gpuctl. Only needed with the FRP
# tunnel: instance bootstraps call back to it.
# GPUCTL_PUBLIC_URL=

# Apply pending database migrations at startup. Set false to run
# `gpuctl migrate` as a separate step.
# GPUCTL_AUTO_MIGRATE=true

# Optional full-access API key seeded at startup for the default organization
# (only its SHA-256 hash is stored). Must look like gpuai_live_ followed by at
# least 24 characters. Alternative: `gpuctl apikey create --name admin`.
# GPUCTL_BOOTSTRAP_API_KEY=

# Logging: info | debug | warn | error, and json | text.
# GPUCTL_LOG_LEVEL=info
# GPUCTL_LOG_FORMAT=json

# Postgres password used by docker-compose (local only).
# POSTGRES_PASSWORD=gpuai-local-dev

# Redis key holding the offerings snapshot; set when two deployments share a Redis.
# OFFERINGS_CACHE_KEY=

# 32-byte key, base64 encoded, that seals stored private-registry passwords.
# Empty leaves /v1/registry-credentials answering 503.
# Generate one with: openssl rand -base64 32
# REGISTRY_CREDENTIALS_KEY=

# Enforce role checks on instance writes (true) instead of logging would-deny
# decisions (false).
# AUTHZ_ENFORCE=false

# ---------------------------------------------------------------------------
# Suppliers
# ---------------------------------------------------------------------------

# Generic suppliers: a JSON array. Each entry implements the Generic Supplier
# API (docs/suppliers.md). Fields: slug (required, [a-z0-9-]), base_url
# (required), name, api_key (sent as a bearer token), regions, disabled.
# Entries are upserted into the suppliers table at startup. docker-compose
# defaults this to the bundled mock supplier.
# GENERIC_SUPPLIERS=[{"slug":"mock","name":"Mock Supplier","base_url":"http://mock-supplier:8080","api_key":"mock-supplier-dev-key"}]

# OAuth2 client credentials for a generic supplier, instead of a static api_key.
# <SLUG> is the slug uppercased with dashes as underscores (acme-gpu -> ACME_GPU).
# The token URL defaults to <base_url>/oauth/token.
# SUPPLIER_OAUTH_CLIENT_ID_<SLUG>=
# SUPPLIER_OAUTH_CLIENT_SECRET_<SLUG>=
# SUPPLIER_OAUTH_TOKEN_URL_<SLUG>=

# Vultr (example real-supplier adapter). Empty leaves it unregistered.
# VULTR_API_KEY=
# Mirrors of the account-side caps Vultr enforces; 0 disables the guard.
# VULTR_MAX_INSTANCES=15
# VULTR_MAX_MONTHLY_COST_USD=4000

# Comma-separated registry names to hide from the catalog and placement while
# keeping existing instances manageable, e.g. "vultr".
# PROVIDERS_DISABLED=

# ---------------------------------------------------------------------------
# Pricing (prices pass through from suppliers by default)
# ---------------------------------------------------------------------------

# Retail markup over supplier prices, in percent.
# GPUCTL_MARKUP_PCT=0
# Per-provider override: PRICING_MARKUP_PCT_<NAME>, e.g. PRICING_MARKUP_PCT_VULTR=5
# Floor: never publish or launch below cost x (1 + pct/100).
# PRICING_MIN_RETAIL_MARKUP_PCT=0
# How far an accepted cost may exceed its quote before a launch is refused.
# PRICING_COST_DRIFT_TOLERANCE_PCT=5
# PRICING_COST_DRIFT_TOLERANCE_ABS=0.02
# How much more a boot-stall rescue replacement may cost than the original.
# PRICING_RESCUE_COST_ALLOWANCE_PCT=150
# PRICING_RESCUE_COST_ALLOWANCE_ABS=0.25
# Negotiated discount below a provider's list price, in [0,100):
# PROVIDER_COST_DISCOUNT_PCT_<NAME>=

# Instance disk: default size, size included in the hourly rate, maximum, and
# the hourly price per GB beyond the included size.
# LAUNCH_DEFAULT_DISK_GB=100
# LAUNCH_INCLUDED_DISK_GB=100
# LAUNCH_MAX_DISK_GB=250
# DISK_PRICE_PER_GB_HOUR=0
# PROVIDER_DISK_PRICE_PER_GB_HOUR_<NAME>=

# ---------------------------------------------------------------------------
# Optional FRP tunnel (off by default: instances are reached directly at the
# supplier-reported address and SSH port)
# ---------------------------------------------------------------------------

# Setting a token enables the embedded frps and per-instance bootstraps.
# FRP_TOKEN=
# FRP_BIND_PORT=7000
# FRP_ALLOW_PORTS=10000-10255
# Public host of frps; defaults to the hostname of GPUCTL_PUBLIC_URL.
# FRP_PUBLIC_HOST=
# Per-provider frpc transport: tcp | websocket | wss | kcp | quic
# FRP_TRANSPORT_<NAME>=
# Wildcard host for app URLs served through the tunnel.
# APPS_HOST=
# WEB_TERMINAL_DISABLED=false
# Startup GPU compute check rendered into tunnel bootstraps: off | shadow | enforce
# PROVISION_GPU_CHECK=shadow
# Tunnel reachability probe tuning (0 = built-in default).
# TUNNEL_FAIL_THRESHOLD=0
# TUNNEL_ESCALATE_AFTER=0

# ---------------------------------------------------------------------------
# Provisioning engine
# ---------------------------------------------------------------------------

# Default environment for launches that name none: certified[:framework] or off.
# PROVISION_DEFAULT_ENVIRONMENT=certified:pytorch
# Apply it to every manifest-covered GPU (all) or only where adapter defaults
# cannot run (incompatible).
# PROVISION_DEFAULT_ENVIRONMENT_SCOPE=incompatible
# Boot-stall watchdog windows (0 disables that leg) and rescue relaunches.
# PROVISION_TUNNEL_STALL_AFTER=8m
# PROVISION_PULL_STALL_AFTER=8m
# PROVISION_BOOT_RESCUES=1
# Kill switches (on by default).
# PROVISION_HOST_QUARANTINE=on
# PROVISION_PLACEMENT_MEMORY=on

# Availability polling and circuit breakers.
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_COOLDOWN_SECONDS=60
# BREAKER_PROBE_TIMEOUT_SECONDS=10
# LAUNCH_BREAKER_WINDOW=0
# LAUNCH_BREAKER_MIN_SAMPLES=0
# LAUNCH_BREAKER_FAIL_RATE=0
# LAUNCH_BREAKER_COOLDOWN_SECONDS=600
# AVAILABILITY_RETENTION_SECONDS=300

# Drift reconciler: dry-run (false) logs intended actions; true acts on them.
# RECONCILER_ENFORCE=false
# RECONCILER_INTERVAL_SECONDS=0
# RECONCILER_RECENT_TERM_WINDOW_HOURS=0

# ---------------------------------------------------------------------------
# Mock supplier (docker-compose profile "mock")
# ---------------------------------------------------------------------------

# docker (start an sshd container per instance) or simulated (no containers).
# MOCK_RUNTIME=docker
# Address customers use to reach published SSH ports, and the host interface
# they are published on.
# MOCK_PUBLIC_IP=127.0.0.1
# MOCK_PUBLISH_IP=127.0.0.1
# Host port for the mock's own API (GET /mock/instances lists its instances).
# MOCK_HOST_PORT=8081
